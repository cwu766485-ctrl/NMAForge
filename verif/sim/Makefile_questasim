
SEED = $(shell date +%s)

all: create_lib compile simulate

create_lib:
	vlib work

compile:
	vlog -l comp.log -sv -mfcu -f rtl.f  \
		+incdir+../agent/ahb \
		+incdir+../env \
		+incdir+../tests \
		+incdir+../tb \
		../agent/ahb/ahb_slv_if.sv \
		../agent/ahb/ahb_slv_pkt.sv \
		../agent/ahb/ahb_slv_generator.sv \
		../agent/ahb/ahb_slv_driver_base.sv \
		../agent/ahb/ahb_slv_driver.sv \
		../agent/ahb/ahb_slv_monitor.sv \
		../agent/ahb/ahb_slv_scoreboard.sv \
		../env/ahb_slv_fcoverage.sv \
		../env/vec_accel_sva.sv \
		../tests/ahb_sramc_base_test.sv \
		../tests/ahb_sramc_test.sv \
		../tb/ahb_sramc_svtb_top.sv


simulate:
	vsim -coverage -assertdebug -sv_seed $(SEED) ahb_sramc_svtb_top -l sim.log -voptargs=+acc -do "log -r *; assertion enable -on; coverage save ./test.ucdb; add wave /ahb_sramc_svtb_top/u_vec_accel_top/*; run -all"

clean: 
	rm -rf work mti_lib transcript modelsim.ini *.log *.wlf test.ucdb
