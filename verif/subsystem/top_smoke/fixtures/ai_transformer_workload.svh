task check_transformer_workload;
  begin
    expect_read(SPAD_BASE + 32'h00010780, 32'h00000000, "Transformer final[0]");
    expect_read(SPAD_BASE + 32'h00010784, 32'h00000001, "Transformer final[1]");
    expect_read(SPAD_BASE + 32'h00010788, 32'hffffffff, "Transformer final[2]");
    expect_read(SPAD_BASE + 32'h0001078c, 32'hfffffffe, "Transformer final[3]");
    expect_read(SPAD_BASE + 32'h00010790, 32'hfffffffe, "Transformer final[4]");
    expect_read(SPAD_BASE + 32'h00010794, 32'hffffffff, "Transformer final[5]");
    expect_read(SPAD_BASE + 32'h00010798, 32'h00000001, "Transformer final[6]");
    expect_read(SPAD_BASE + 32'h0001079c, 32'hffffffff, "Transformer final[7]");
    expect_read(SPAD_BASE + 32'h000107a0, 32'h00000001, "Transformer final[8]");
    expect_read(SPAD_BASE + 32'h000107a4, 32'hfffffffe, "Transformer final[9]");
    expect_read(SPAD_BASE + 32'h000107a8, 32'hffffffff, "Transformer final[10]");
    expect_read(SPAD_BASE + 32'h000107ac, 32'hffffffff, "Transformer final[11]");
    expect_read(SPAD_BASE + 32'h000107b0, 32'h00000000, "Transformer final[12]");
    expect_read(SPAD_BASE + 32'h000107b4, 32'hfffffffe, "Transformer final[13]");
    expect_read(SPAD_BASE + 32'h000107b8, 32'hffffffff, "Transformer final[14]");
    expect_read(SPAD_BASE + 32'h000107bc, 32'h00000001, "Transformer final[15]");
  end
endtask
